<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Users</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="container">
    <h1>Users</h1>

    <% if (users.length === 0) { %>
      <p>No users found.</p>
    <% } else { %>
      <table class="user-table">
        <thead>
          <tr>
            <th>Username</th>
            <th>Age</th>
            <th>City</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach((user) => { %>
            <tr>
              <td><%= user.username %></td>
              <td><%= user.age %></td>
              <td><%= user.city %></td>
              <td>
                <form action="/users/<%= user._id %>/delete" method="post" class="inline-form">
                  <button type="submit" class="danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

    <div class="actions">
      <a class="button" href="/">Create another user</a>
    </div>
  </div>
</body>
</html>
